{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/test",
      "destination": "/api/test"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/test.js": {
      "includeFiles": "dist/**"
    },
    "api/index.js": {
      "includeFiles": "dist/**"
    }
  }
}
