model NavItem {
  id          String    @id @default(uuid()) @db.Uuid
  menuId      String    @db.Uuid
  parentId    String?   @db.Uuid
  label       Json // i18n
  description Json? // i18n, for mega-menu cards
  badge       Json? // i18n, e.g. "New"
  iconKey     String?
  href        String? // external/custom
  pageId      String?   @db.Uuid // OR internal page …
  productId   String?   @db.Uuid // … OR product
  serviceId   String?   @db.Uuid // … OR service
  newTab      Boolean   @default(false)
  isButton    Boolean   @default(false)
  isVisible   Boolean   @default(true)
  sortOrder   Int       @default(0)
  menu        NavMenu   @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent      NavItem?  @relation("NavTree", fields: [parentId], references: [id])
  children    NavItem[] @relation("NavTree")
  page        Page?     @relation(fields: [pageId], references: [id])
  product     Product?  @relation(fields: [productId], references: [id])
  service     Service?  @relation(fields: [serviceId], references: [id])

  @@index([menuId, sortOrder])
}
