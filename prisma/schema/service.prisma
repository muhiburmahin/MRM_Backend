model Service {
  id                  String                   @id @default(uuid()) @db.Uuid
  slug                String                   @unique // web-development, custom-software-development
  status              ContentStatus            @default(PUBLISHED)
  title               String?
  name                String?
  tagline             String?
  shortDescription    String?                  @db.Text
  description         String?                  @db.Text
  fullDescription     String?                  @db.Text
  problemSolved       String?                  @db.Text
  problemsAddressed   String?                  @db.Text
  targetAudience      String?                  @db.Text
  ourApproachSummary  String?                  @db.Text
  approach            String?                  @db.Text
  serviceType         String?                  @default("Custom Engineering")
  brandColor          String?                  // e.g. #2563EB
  coverImage          String?
  coverImageUrl       String?
  thumbnailImage      String?
  thumbnailUrl        String?
  icon                String?                  // Lucide icon name (e.g. Code2, Cpu, Smartphone)

  // Visibility & Status Controls
  isFeatured          Boolean                  @default(false)
  showOnServicesPage  Boolean                  @default(true)
  showOnHomepage      Boolean                  @default(false)
  showInNavbar        Boolean                  @default(true)
  showInNavDropdown   Boolean                  @default(true)
  allowPublicDetail   Boolean                  @default(true)

  // Separate Admin-Controlled Priority Ordering
  servicesPageOrder   Int                      @default(0)
  homepageOrder       Int                      @default(0)
  navbarOrder         Int                      @default(0)
  featuredOrder       Int                      @default(0)
  sortOrder           Int                      @default(0) // Legacy compatibility

  // Custom CTA Overrides
  primaryCtaLabel     String?                  @default("Start a Project")
  secondaryCtaLabel   String?                  @default("Request a Consultation")

  // SEO Metadata
  seoTitle            String?
  metaDescription     String?                  @db.Text
  seoDescription      String?                  @db.Text
  seoKeywords         String?
  keywords            String[]                 @default([])
  canonicalUrl        String?
  ogTitle             String?
  ogDescription       String?                  @db.Text
  ogImage             String?
  twitterImage        String?
  noIndex             Boolean                  @default(false)
  includeInSitemap    Boolean                  @default(true)

  // Category relation
  categoryId          String?                  @db.Uuid
  category            ServiceCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  // Rich Sub-Collections
  offerings           ServiceOfferingItem[]
  benefits            ServiceBenefitItem[]
  processSteps        ServiceProcessStepItem[]
  mediaGallery        ServiceMediaItem[]
  serviceFaqs         ServiceFaqItem[]

  // Existing Relations Preserved (Zero Data Loss)
  isActive            Boolean                  @default(true)
  translations        ServiceTranslation[]
  faqs                Faq[]                    // Legacy FAQ relation
  leads               Lead[]
  caseStudies         CaseStudy[]
  pricingPlans        PricingPlan[]
  technologies        ServiceTechnology[]
  navItems            NavItem[]

  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([status, showOnServicesPage, servicesPageOrder])
  @@index([status, showOnHomepage, homepageOrder])
  @@index([status, showInNavbar, navbarOrder])
}
