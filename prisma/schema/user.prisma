model User {
  id                 String    @id @default(uuid()) @db.Uuid
  email              String    @unique
  name               String
  passwordHash       String? // argon2id
  avatarId           String?   @db.Uuid
  uiLocale           String    @default("en")
  isActive           Boolean   @default(true)
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecretEnc String? // encrypted TOTP secret
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  roleId             String    @db.Uuid
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  deletedAt          DateTime?

  role          Role               @relation(fields: [roleId], references: [id])
  avatar        MediaAsset?        @relation("UserAvatar", fields: [avatarId], references: [id])
  sessions      Session[]
  recoveryCodes RecoveryCode[]
  resets        PasswordReset[]
  assignedLeads Lead[]             @relation("LeadAssignee")
  leadNotes     LeadNote[]
  leadChanges   LeadStatusChange[]
  uploads       MediaAsset[]       @relation("MediaUploader")
  auditLogs     AuditLog[]
  revisions     Revision[]
  invitesSent   UserInvite[]       @relation("InviteBy")
  themes        Theme[]

  @@index([roleId])
}
