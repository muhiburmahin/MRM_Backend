model Product {
  id             String      @id @default(uuid()) @db.Uuid
  slug           String      @unique // edumanage-bd, medisheba-bd
  stage          LaunchStage @default(LIVE)
  logoId         String?     @db.Uuid // -> MediaAsset.id
  heroImageId    String?     @db.Uuid // -> MediaAsset.id
  brandColor     String? // product accent (hex), shown on cards
  productSiteUrl String?
  demoUrl        String?
  privacyUrl     String?
  termsUrl       String?
  isFeatured     Boolean     @default(false)
  sortOrder      Int         @default(0)
  launchedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  translations ProductTranslation[]
  features     ProductFeature[]
  screenshots  ProductScreenshot[]
  plans        PricingPlan[]
  industries   ProductIndustry[]
  faqs         Faq[]
  leads        Lead[]
  caseStudies  CaseStudy[]
  navItems     NavItem[]
}
