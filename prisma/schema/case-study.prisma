model CaseStudy {
  id               String    @id @default(uuid()) @db.Uuid
  slug             String    @unique
  clientId         String?   @db.Uuid
  productId        String?   @db.Uuid
  serviceId        String?   @db.Uuid
  industryId       String?   @db.Uuid
  coverId          String?   @db.Uuid // -> MediaAsset.id
  liveUrl          String?
  startedAt        DateTime?
  completedAt      DateTime?
  metrics          Json      @default("[]") // only verifiable figures
  isVerified       Boolean   @default(false)
  evidenceNote     String?
  clientApprovedAt DateTime?
  publishedAt      DateTime?
  sortOrder        Int       @default(0)

  // Portfolio & Repository Control fields
  projectWorkStatus   String   @default("COMPLETED") // COMPLETED, ONGOING, INTERNAL
  isFeatured          Boolean  @default(false)
  demoVideoUrl        String?
  frontendRepoUrl     String?
  backendRepoUrl      String?
  showFrontendRepo    Boolean  @default(false)
  showBackendRepo     Boolean  @default(false)
  frontendTechSummary Json?    // e.g. ["Next.js", "TypeScript", "Tailwind CSS"]
  backendTechSummary  Json?    // e.g. ["NestJS", "PostgreSQL", "Prisma"]
  dbToolsSummary      Json?    // e.g. ["Redis", "Docker", "Cloudflare R2"]

  client       Client?                @relation(fields: [clientId], references: [id])
  product      Product?               @relation(fields: [productId], references: [id])
  service      Service?               @relation(fields: [serviceId], references: [id])
  industry     Industry?              @relation(fields: [industryId], references: [id])
  translations CaseStudyTranslation[]
  technologies CaseStudyTechnology[]
  gallery      CaseStudyMedia[]
}
