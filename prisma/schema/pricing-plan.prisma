// Pricing for a PRODUCT (plans) or a SERVICE (engagement models: fixed price,
// dedicated team, hourly …). Exactly one of productId / serviceId (CHECK in constraints.sql).
model PricingPlan {
  id            String        @id @default(uuid()) @db.Uuid
  productId     String?       @db.Uuid
  serviceId     String?       @db.Uuid
  i18n          Json // name, description, features[], priceLabel override
  amount        Decimal?      @db.Decimal(12, 2)
  currency      String        @default("USD") // ISO 4217: USD, BDT, EUR, GBP …
  billingPeriod BillingPeriod @default(CUSTOM)
  isPublic      Boolean       @default(false) // false => "Ask for pricing"
  isFeatured    Boolean       @default(false)
  sortOrder     Int           @default(0)
  product       Product?      @relation(fields: [productId], references: [id], onDelete: Cascade)
  service       Service?      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([serviceId])
}
