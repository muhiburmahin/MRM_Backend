model TeamMember {
  id           String                  @id @default(uuid()) @db.Uuid
  slug         String                  @unique
  name         String?
  role         String?
  photo        String?
  bio          String?                 @db.Text
  email        String?
  showEmail    Boolean                 @default(false)
  linkedinUrl  String?
  githubUrl    String?
  order        Int                     @default(0)
  sortOrder    Int                     @default(0)
  isActive     Boolean                 @default(true)
  isPublic     Boolean                 @default(true) // member consent to be listed
  photoId      String?                 @db.Uuid // -> MediaAsset.id
  department   String?
  socialLinks  Json                    @default("{}")
  consentAt    DateTime?
  joinedAt     DateTime?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  translations TeamMemberTranslation[]
  posts        Post[]
}
