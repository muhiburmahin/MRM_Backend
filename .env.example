# ==============================================================================
# MRM InfoTech Backend — Environment Configuration Reference (.env.example)
# Copy to .env and replace placeholders. NEVER commit .env to version control.
# ==============================================================================

# Application Environment: development | test | staging | production
NODE_ENV=development
PORT=4000

# PostgreSQL Connection URL
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public

# Allowed Frontend Origins (Comma-separated exact origins for CORS and CSRF checks)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000

# Authentication & Session Security (Minimum 16 characters secret for hashing)
AUTH_IP_HASH_SALT=<GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_16_CHARACTERS>
SESSION_SECRET=<GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_16_CHARACTERS>
AUTH_COOKIE_NAME=mrm_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12

# Optional 32-byte hex key for encrypting 2FA TOTP secrets at rest
AUTH_2FA_ENCRYPTION_KEY=
TWO_FACTOR_ENCRYPTION_KEY=

# Reverse Proxy Trust Configuration (0 = direct, 1 = Nginx/Cloudflare/AWS ALB)
TRUST_PROXY=0

# Logging Level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Swagger API Documentation at /docs (defaults to true in dev, false in prod)
SWAGGER_ENABLED=true

# Global Rate Limiting (per IP): THROTTLE_LIMIT requests per THROTTLE_TTL_SECONDS
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Timezone Alignment (IANA Time Zone format)
TZ=Asia/Dhaka
APP_TIMEZONE=Asia/Dhaka

# Transactional Email & Lead Notification Configuration (Optional)
MAIL_ENABLED=false
MAIL_FROM="MRM InfoTech <no-reply@mrminfotech.com>"
MAIL_NOTIFY_RECIPIENT="leads@mrminfotech.com"
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=postmaster@mrminfotech.com
SMTP_PASSWORD=

# Media Storage / Cloudinary Configuration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
