# Copy to .env and replace placeholders. NEVER commit .env or put production secrets in this file.

NODE_ENV=development
PORT=4000

# PostgreSQL connection string. Local dev example only (matches docker-compose.yml).
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DATABASE>?schema=public

# Comma-separated list of exact frontend origins allowed by CORS.
# Empty = no cross-origin browser access (safe default).
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Cookie-based admin sessions. Use a unique random value of at least 16 characters.
AUTH_IP_HASH_SALT=<GENERATE_A_RANDOM_SECRET_OF_AT_LEAST_16_CHARACTERS>
# Must include the exact browser origins permitted by CORS_ORIGINS.
AUTH_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
AUTH_COOKIE_NAME=mrm_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_SESSION_TTL_HOURS=12

# Optional 32-byte hex key for encrypting 2FA TOTP secrets at rest (defaults to salt derivation if omitted).
AUTH_2FA_ENCRYPTION_KEY=

# Number of reverse proxies in front of the API (0 = none, 1 = Nginx/Cloudflare/Render...).
# Needed so rate limiting sees the real client IP. Do not set higher than the real number.
TRUST_PROXY=0

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=debug

# Swagger UI at /docs. Defaults: on in development, off in production.
SWAGGER_ENABLED=true

# Global rate limit (per IP): LIMIT requests per TTL seconds.
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=120

# Process/business time zone used for display and scheduling. Database timestamps remain UTC.
TZ=Asia/Dhaka
APP_TIMEZONE=Asia/Dhaka

# Transactional Email & Lead Notification Configuration
MAIL_ENABLED=false
MAIL_FROM="MRM InfoTech <no-reply@mrminfotech.com>"
MAIL_NOTIFY_RECIPIENT="leads@mrminfotech.com"
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
